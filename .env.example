# Anthropic API key for AI niche enrichment + call-note parsing.
# When unset, the app falls back to deterministic scoring + a regex-based
# notes parser. Required if you want either AI feature.
ANTHROPIC_API_KEY=

# Database connection string (libsql).
# - Unset (dev)   → file:./data/villarosa-dev.db (persistent, gitignored)
# - Unset (prod)  → file:/tmp/villarosa.db       (ephemeral on Vercel)
# - file:...      → local SQLite file
# - libsql://...  → remote Turso instance (requires DATABASE_AUTH_TOKEN)
DATABASE_URL=

# Auth token for the remote Turso DB. Leave empty for local file mode.
# Generate one with: turso db tokens create <db-name>
DATABASE_AUTH_TOKEN=
